{
  "name": "memo-grafter",
  "version": "0.5.1",
  "description": "Structured conversational memory for LLM chatbot applications",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayhemking007/memo-grafter.git"
  },
  "homepage": "https://github.com/mayhemking007/memo-grafter",
  "bugs": {
    "url": "https://github.com/mayhemking007/memo-grafter/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "memo-grafter": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js",
      "default": "./dist/schema/index.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "import": "./dist/store/index.js",
      "default": "./dist/store/index.js"
    },
    "./studio": {
      "types": "./dist/studio/index.d.ts",
      "import": "./dist/studio/index.js",
      "default": "./dist/studio/index.js"
    }
  },
  "files": [
    "dist",
    "assets",
    ".env.example",
    "README.md",
    "USER_GUIDE.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "migrate": "tsx scripts/migrate.ts",
    "doctor": "tsx scripts/doctor.ts",
    "typecheck": "tsc -p tsconfig.src.json --noEmit && tsc -p tsconfig.cli.json --noEmit",
    "lint": "eslint .",
    "prepublishOnly": "npm run build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:package": "npm run build && node tests/package/storage-entrypoint-smoke.mjs",
    "test:watch": "vitest --watch",
    "test:core": "tsx --env-file=.env tests/core/run.ts",
    "test:fleet": "tsx --env-file=.env tests/fleet/run.ts",
    "live-smoke:grafter": "tsx --env-file=.env tests/manual/live-smoke/grafter/run.ts",
    "live-smoke:graph": "tsx --env-file=.env tests/manual/live-smoke/graph/run.ts",
    "live-smoke:ingestion": "tsx --env-file=.env tests/manual/live-smoke/ingestion/run.ts",
    "live-smoke:ingest-text": "tsx --env-file=.env tests/manual/live-smoke/ingestion/ingest-text-run.ts",
    "live-smoke:fleet": "tsx --env-file=.env tests/manual/live-smoke/fleet/run.ts",
    "live-smoke:crawler": "tsx --env-file=.env tests/manual/live-smoke/crawler/run.ts",
    "live-smoke:maintenance": "tsx --env-file=.env tests/manual/live-smoke/maintenance/run.ts",
    "live-smoke:cache": "tsx --env-file=.env tests/manual/live-smoke/cache/run.ts",
    "live-smoke:external": "tsx --env-file=.env tests/manual/live-smoke/external-application/run.ts",
    "manual:contextualized-retrieval": "tsx --env-file=.env tests/manual/contextualized-retrieval-query.ts",
    "live-smoke:smoke": "tsx --env-file=.env tests/manual/live-smoke/run.ts",
    "accuracy:memory": "tsx --env-file=.env tests/manual/accuracy/run.ts",
    "accuracy:retrieval-impact": "tsx tests/manual/accuracy/retrieval-candidate-selection-impact.ts",
    "manual:memory-quality": "tsx --env-file=.env tests/manual/memory-quality.ts"
  },
  "keywords": [
    "llm",
    "memory",
    "chatbot",
    "rag",
    "knowledge-graph",
    "langchain",
    "openai"
  ],
  "author": "Sarthak Chaturvedi <sarthakchat2018@gmail.com>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bullmq": "^5.0.0",
    "ioredis": "^5.0.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "@eslint/js": "^10.0.1",
    "@google/genai": "^0.15.0",
    "@types/node": "^25.6.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.5.0",
    "openai": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "@google/genai": "^0.15.0",
    "openai": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@google/genai": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  }
}
